    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: gsl_program_I",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gsl_program.py",
            "console": "integratedTerminal",
            "args": ["{a + b @NEWLINE $}"]
        },
        {
            "name": "Python Debugger: gsl_program_A",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gsl_program.py",
            "console": "integratedTerminal",
            "args": ["{algo rasmus() @NEWLINE @INDENT 1 + 2 @NEWLINE @DEDENT algo martin() @NEWLINE @INDENT 3 + 4 @NEWLINE @DEDENT algo ahmed() @NEWLINE @INDENT 3 + 4 @NEWLINE @DEDENT $}"],
        }
    ]
}