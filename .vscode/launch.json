    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: gsl_program_I",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gsl_program.py",
            "console": "integratedTerminal",
            "args": ["{1 + 2 @NEWLINE $}"]
        },
        {
            "name": "Python Debugger: gsl_program_A",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gsl_program.py",
            "console": "integratedTerminal",
            "args": ["{algo rasmus(a in int, b in int) return int @NEWLINE @INDENT c,d in int @NEWLINE c := a @NEWLINE d := b @NEWLINE return c + d @NEWLINE @DEDENT algo martin() @NEWLINE @INDENT 3 + 4 @NEWLINE @DEDENT rasmus(2,3) @NEWLINE $}"],
        }
    ]
}