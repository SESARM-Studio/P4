            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gsl_program.py",
            "console": "integratedTerminal",
            "args": [
                "{i in int := 6 @NEWLINE digraph G with int weight @NEWLINE @INDENT node a,b,c,d,e @NEWLINE edge a-->b,c,d,e weight 6,7,6,7 @NEWLINE @DEDENT for each edge x<--y with weight i in G @NEWLINE @INDENT G add edge y-->c,x @NEWLINE G add edge y-->y @NEWLINE display x @NEWLINE display y @NEWLINE display i @NEWLINE @DEDENT $}"
            ]
        },
